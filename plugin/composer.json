{
    "name": "emcp/elementor-mcp-server",
    "description": "WordPress companion plugin for the Elementor MCP server.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "EMCP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EMCP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
