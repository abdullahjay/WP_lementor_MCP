# Copy to .env before running docker compose up.
# Values here are development-only defaults — never used outside the local sandbox.

# --- WordPress sandboxes ---
WP_V4_PRO_PORT=8081
WP_V3_FREE_PORT=8082
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_dev_only
WP_DB_ROOT_PASSWORD=root_dev_only
WP_DB_PASSWORD=wp_dev_only

# --- Elementor Pro license/download (wp-v4-pro only) ---
# The Pro plugin zip isn't publicly downloadable. Place it at
# ./sandboxes/wp-v4-pro/elementor-pro.zip before first provision, or set a URL here
# if your license allows scripted retrieval.
ELEMENTOR_PRO_ZIP_PATH=./sandboxes/wp-v4-pro/elementor-pro.zip

# --- Node MCP server ---
MCP_PORT=3000
MCP_HEADER_AUTH_TOKEN=dev_local_token_change_me
LOG_LEVEL=debug

# --- PostgreSQL (Node server's own database — registry, grants, ledger index) ---
POSTGRES_PORT=5433
POSTGRES_DB=emcp
POSTGRES_USER=emcp
POSTGRES_PASSWORD=emcp_dev_only

# --- Renderer (Playwright) ---
RENDERER_PORT=3100

# --- MinIO (S3-compatible object storage: screenshots, reference designs) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only
