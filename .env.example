# Copy to .env before running docker compose up.
# Values here are development-only defaults — never used outside the local sandbox.

# --- WordPress sandboxes ---
WP_V4_PRO_PORT=8081
WP_V3_FREE_PORT=8082
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_dev_only
WP_DB_ROOT_PASSWORD=root_dev_only
WP_DB_PASSWORD=wp_dev_only

# --- Elementor Pro license/download (wp-v4-pro only) ---
# The Pro plugin zip isn't publicly downloadable. Place it at
# ./sandboxes/wp-v4-pro/elementor-pro.zip before first provision, or set a URL here
# if your license allows scripted retrieval.
ELEMENTOR_PRO_ZIP_PATH=./sandboxes/wp-v4-pro/elementor-pro.zip

# --- Node MCP server ---
MCP_PORT=3000
MCP_HEADER_AUTH_TOKEN=dev_local_token_change_me
LOG_LEVEL=debug

# --- WordPress target site (EMCP-007+) ---
# One connector = one site (solution.md §3) — there is no site_id anywhere
# in this server. Until the site registry exists (EMCP-013+), which site
# this Node server talks to is just these three vars. Point at whichever
# sandbox you're testing against (http://localhost:8081 or :8082 from the
# host; http://wp-v4-pro or http://wp-v3-free from inside the dev/mcp
# containers). WP_AUTH_APP_PASSWORD is NOT WP_ADMIN_PASSWORD above — generate
# one per site with:
#   docker compose run --rm wpcli-v4-pro wp user application-password create admin emcp-dev --porcelain
WP_BASE_URL=http://wp-v4-pro
WP_AUTH_USER=admin
WP_AUTH_APP_PASSWORD=

# --- Per-sandbox Application Passwords (EMCP-011, scripts/verify-live.sh) ---
# scripts/verify-live.sh checks both sandboxes directly, independent of
# whichever one WP_BASE_URL above points the Node server at. Generate one
# persistent password per site (name it something you'll recognize, e.g.
# "emcp-dev-verify-live") rather than the ad hoc ones manual testing creates:
#   docker compose run --rm wpcli-v4-pro wp user application-password create admin emcp-dev-verify-live --porcelain
#   docker compose run --rm wpcli-v3-free wp user application-password create admin emcp-dev-verify-live --porcelain
WP_V4_PRO_AUTH_APP_PASSWORD=
WP_V3_FREE_AUTH_APP_PASSWORD=

# --- Credential envelope encryption (EMCP-015) ---
# Dev-only stand-in for a KMS-sourced KEK — see server/src/credentials/kek.ts.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEK=

# --- PostgreSQL (Node server's own database — registry, grants, ledger index) ---
# POSTGRES_PORT is the HOST-mapped port (outside Docker); POSTGRES_HOST is
# the docker-compose service name, used by mcp/dev connecting over data_net.
POSTGRES_HOST=db
POSTGRES_PORT=5433
POSTGRES_DB=emcp
POSTGRES_USER=emcp
POSTGRES_PASSWORD=emcp_dev_only

# --- Renderer (Playwright) ---
RENDERER_PORT=3100

# --- MinIO (S3-compatible object storage: screenshots, reference designs) ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only
MINIO_BUCKET=emcp-previews
