{
  "name": "emcp-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Playwright rendering service (solution.md §9.5) — separate host/network segment, no credential store, no KMS grant.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:unit": "npm run type-check && npm run lint && npm run test"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "playwright-core": "1.48.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
